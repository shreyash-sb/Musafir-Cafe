# ==============================================================================
# Musafir Cafe & Roastery — Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (Comma separated)
CORS_ORIGIN=http://localhost:4500,http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection Options
# ------------------------------------------------------------------------------
# Option 1: Full Connection String (Works with Neon, Supabase, Render, Railway, AWS RDS, Docker, etc.)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/musafir_cafe

# Option 2: Individual Connection Parameters (Alternative)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=musafir_cafe

# Enable SSL for cloud-hosted databases (Supabase, Neon, Render)
# Set to 'true' if using a remote cloud PostgreSQL instance
DATABASE_SSL=false

